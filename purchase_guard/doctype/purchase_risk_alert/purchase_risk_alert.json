{
  "doctype": "DocType",
  "name": "Purchase Risk Alert",
  "module": "Purchase Guard",
  "custom": 0,
  "allow_rename": 1,
  "autoname": "format:PG-ALERT-.#####",
  "track_changes": 1,
  "field_order": [
    "company",
    "supplier",
    "risk_type",
    "severity",
    "risk_score",
    "amount",
    "item_code",
    "title",
    "evidence",
    "recommended_action",
    "status",
    "reviewed_by",
    "review_notes",
    "is_demo_data"
  ],
  "fields": [
    {
      "fieldname": "company",
      "label": "Company",
      "fieldtype": "Link",
      "options": "Company",
      "reqd": 1,
      "read_only": 1
    },
    {
      "fieldname": "supplier",
      "label": "Supplier",
      "fieldtype": "Link",
      "options": "Supplier",
      "read_only": 1
    },
    {
      "fieldname": "reference_doctype",
      "label": "Reference DocType",
      "fieldtype": "Link",
      "options": "DocType",
      "read_only": 1,
      "hidden": 1
    },
    {
      "fieldname": "reference_name",
      "label": "Reference",
      "fieldtype": "Dynamic Link",
      "options": "reference_doctype",
      "read_only": 1,
      "hidden": 1
    },
    {
      "fieldname": "risk_type",
      "label": "Risk Type",
      "fieldtype": "Select",
      "options": "Duplicate Invoice\nPO Price Variance\nReceipt Quantity Variance\nMaverick Purchase\nHigh Value Purchase\nHigh Value Payment\nSupplier Price Increase\nPO Split Risk\nOther",
      "reqd": 1,
      "read_only": 1
    },
    {
      "fieldname": "severity",
      "label": "Severity",
      "fieldtype": "Select",
      "options": "Low\nMedium\nHigh\nCritical",
      "reqd": 1,
      "read_only": 1
    },
    {
      "fieldname": "risk_score",
      "label": "Risk Score",
      "fieldtype": "Percent",
      "read_only": 1
    },
    {
      "fieldname": "amount",
      "label": "Amount at Risk",
      "fieldtype": "Currency",
      "read_only": 1
    },
    {
      "fieldname": "item_code",
      "label": "Item",
      "fieldtype": "Link",
      "options": "Item",
      "read_only": 1
    },
    {
      "fieldname": "title",
      "label": "Finding",
      "fieldtype": "Data",
      "reqd": 1,
      "read_only": 1
    },
    {
      "fieldname": "evidence",
      "label": "Evidence",
      "fieldtype": "Long Text",
      "reqd": 1,
      "read_only": 1
    },
    {
      "fieldname": "recommended_action",
      "label": "Recommended Action",
      "fieldtype": "Long Text",
      "reqd": 1,
      "read_only": 1
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Open\nUnder Review\nAccepted\nResolved\nFalse Positive",
      "default": "Open",
      "reqd": 1
    },
    {
      "fieldname": "reviewed_by",
      "label": "Reviewed By",
      "fieldtype": "Link",
      "options": "User"
    },
    {
      "fieldname": "review_notes",
      "label": "Review Notes",
      "fieldtype": "Long Text"
    },
    {
      "fieldname": "is_demo_data",
      "label": "Demo Data",
      "fieldtype": "Check",
      "default": "0",
      "read_only": 1,
      "hidden": 1
    }
  ],
  "permissions": [
    {
      "role": "Purchase Guard Analyst",
      "read": 1,
      "write": 1,
      "create": 0,
      "report": 1,
      "export": 1
    },
    {
      "role": "Purchase Guard Manager",
      "read": 1,
      "write": 1,
      "create": 0,
      "delete": 1,
      "report": 1,
      "export": 1,
      "share": 1
    }
  ]
}
